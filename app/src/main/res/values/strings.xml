    <string name="help_section_setup_title">Setting Up Your Card</string>
    <string name="help_section_setup_desc">Select your own contact card from Google Contacts to populate your information. You can customize fields and edit what is shown across Contact, Professional, and Custom profiles.</string>
    
    <string name="help_section_nfc_title">NFC Sharing (MeDrop)</string>
    <string name="help_section_nfc_desc">Turn on NFC in your system settings. Hold your device near another NFC-enabled Android or iOS device. When detected, the other phone will receive your virtual vCard contact details instantly.</string>

    <string name="help_section_lockscreen_title">Lockscreen Access</string>
    <string name="help_section_lockscreen_desc">Enable \"Allow when Locked\" in Settings to allow launching your contact card sheet directly from the Quick Settings Tile over the keyguard without unlocking your device.</string>

    <string name="help_section_profiles_title">Multiple Profiles</string>
    <string name="help_section_profiles_desc">Manage different digital identity cards: use the Personal Contact profile for friends, Professional for networking and work colleagues, and Custom for tailored events.</string>

